":[20,19]},{"stage":2,"task":"Cylinder","successes":[null,20]}]}}},"sources":[{"group":"AutoMate","file":"interactive/data.json","sha256":"a56542f29f5363fa39cd9f8cdcddb413e1b6de4b18a705510d85e4dfbd8a193c"},{"group":"NIST","file":"interactive/nist/data.json","sha256":"f0bb055c324e74f38c8cf6b4318aa81bdd1ae67dc8e3e3614a89cbf66305dbeb"}],"version":1,"forge":{"title":"FORGE \u00b7 New task performance","axis":"FWT","values":{"RFM base":0.6466666666666667,"Single-task RL":0.741,"ACCRUE":0.823},"base_reference":"base_reference.json","base_interpretation":"Equal mean of 12 current-task SR evaluations across the four task orders. A frozen no-RL policy has a constant learning curve, whose normalized AUC equals that SR. This is a derived static reference, not an observed RL learning trajectory.","rl_interpretation":"Published FWT point estimates from the existing FORGE slide; four task orders and four RL seeds.","uncertainty":"No error bars: RL aggregate uncertainties are not supplied; base checkpoints are shared across RL seeds.","not_used":"The paper base final accuracy 0.687 is a different final-checkpoint metric and is not the plotted baseline.","axis_limits":[0.5,0.9],"axis_break_mark":true,"png_dimensions":[1500,1200],"aspect_ratio":"5:4","equal_bar_widths":true,"output_format":"PNG only","dpi":150,"font_points":{"title":30,"methods":26,"values":30,"y_axis":24,"y_ticks":21,"direction":17,"base_note":14}},"definitions":{"success":"Rolling success over 20 valid online RL episodes; displayed curves use the source EMA (0.8 new + 0.2 previous). Dashed segments precede a full 20-episode window.","robot_time":"Cumulative recorded online robot interaction in minutes, including warmup. Not demonstration collection time or wall-clock training time.","savings":"100 \u00d7 (1 \u2212 ACCRUE recorded robot time / single-task recorded robot time), separately per task. Stage 1 is shared.","retention":"Separate 20-trial evaluations of earlier tasks at the end of each later stage. Qualitative clips do not supply these counts.","fwt":"FWT averages current-task success rates over a uniform evaluation grid, then across tasks. Higher is better; it is not a success-rate difference from single-task RL."}}
